<Window x:Class="FileSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="File Search"
        Icon="pack://application:,,,/icon.ico"
        Width="1000"
        Height="700"
        MinWidth="700"
        MinHeight="500"
        Background="#202020"
        Foreground="White">

    <DockPanel>

        <!-- Top menu -->
        <Menu DockPanel.Dock="Top"
      Background="#252525"
      Foreground="White"
      Height="20"
      Padding="0">

            <MenuItem Height="20"
              Padding="0"
              Margin="0">

                <MenuItem.Template>
                    <ControlTemplate TargetType="MenuItem">

                        <Grid>
                            <Border x:Name="HeaderBorder"
                            Background="Transparent"
                            Padding="5,0">

                                <ContentPresenter
                            ContentSource="Header"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0"/>
                            </Border>

                            <Popup
                        IsOpen="{Binding IsSubmenuOpen,
                                         RelativeSource={RelativeSource TemplatedParent}}"
                        Placement="Bottom"
                        PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        AllowsTransparency="True"
                        Focusable="False">

                                <Border Background="#252525"
                                BorderBrush="#454545"
                                BorderThickness="1">

                                    <StackPanel IsItemsHost="True"/>

                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                             Value="True">
                                <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </MenuItem.Template>

                <MenuItem.Header>
                    <TextBlock Text="Registry"
                       Foreground="White"
                       FontSize="12"
                       Margin="0"
                       Padding="0"
                       TextWrapping="NoWrap"/>
                </MenuItem.Header>

                <MenuItem Header="Install to Registry" Click="InstallRegistry_Click"/>

                <MenuItem Header="Remove from Registry" Click="RemoveRegistry_Click"/>

            </MenuItem>

        </Menu>

        <!-- Existing UI -->
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- Top row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathTextBox"
                         TextChanged="PathTextBox_TextChanged"
                         Grid.Column="0"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Background="#303030"
                         Foreground="White"
                         BorderBrush="#494949"
                         BorderThickness="2"/>

                <Button Grid.Column="2"
                        Click="BrowseButton_Click"
                        Content="Browse..."
                        Background="#252525"
                        Foreground="White"
                        BorderBrush="#505050"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        Width="110"/>
            </Grid>

            <!-- Large file list -->
            <Grid Grid.Row="2">

                <DataGrid x:Name="FileList"
              MouseDoubleClick="FileList_MouseDoubleClick"
              Sorting="FileList_Sorting"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Background="#303030"
              Foreground="White">

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open"
                          Click="FileList_Open_Click"/>

                            <MenuItem Header="Open File Location"
                          Click="FileList_OpenLocation_Click"/>

                            <Separator/>

                            <MenuItem Header="Copy Path"
                          Click="FileList_CopyPath_Click"/>

                            <MenuItem Header="Copy Relative Path"
                          Click="FileList_CopyRelative_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Name"
                            Binding="{Binding Name}"
                            SortMemberPath="Name"
                            Width="250"/>

                        <DataGridTextColumn
                            Header="Size"
                            Binding="{Binding Length}"
                            SortMemberPath="Length"
                            Width="100"/>

                        <DataGridTextColumn
                            Header="Modified"
                            Binding="{Binding LastWriteTime}"
                            SortMemberPath="LastWriteTime"
                            Width="160"/>

                        <DataGridTextColumn
                            Header="Path"
                            Binding="{Binding FullName}"
                            SortMemberPath="FullName"
                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- Loading overlay -->
                <Border x:Name="LoadingOverlay"
                        Background="#60000000"
                        Visibility="Collapsed"
                        Panel.ZIndex="10"/>

                <!-- Loading spinner -->
                <ui:ProgressRing x:Name="LoadingRing"
                     Width="42"
                     Height="42"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Panel.ZIndex="11"/>

            </Grid>

            <!-- Search row -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search"
                           VerticalAlignment="Center"
                           Foreground="White"/>

                <TextBox x:Name="SearchTextBox"
                         TextChanged="SearchTextBox_TextChanged"
                         Grid.Column="1"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Background="#303030"
                         Foreground="White"
                         BorderBrush="#494949"
                         BorderThickness="2"/>
            </Grid>

            <!-- Status -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="6"
                       Text="Select a folder to begin."
                       Foreground="#D0D0D0"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Grid>

    </DockPanel>
</Window>